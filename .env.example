# Copy to .env or export before `docker compose up`.

# The fault switch: false = buggy (default), true = fixed.
FIX_ENABLED=false

# Bounded pool — the resource ADR 0002 exhausts.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=5

# Downstream latency profile.
DOWNSTREAM_BASE_MS=300
DOWNSTREAM_JITTER_MS=500
DOWNSTREAM_SPIKE_PROB=0.05
